{
  "version": "2.0",
  "filters": {
    "volatility": {
      "warning": 2.5,
      "anomaly": 3.5,
      "critical": 5.0
    },
    "volume": {
      "warning": 2.2,
      "anomaly": 3.0,
      "critical": 4.5,
      "seasonal_adjustment": {
        "month": 12,
        "multiplier": 1.2
      }
    },
    "rsi_trm": {
      "warning": { "lower": 25, "upper": 75 },
      "anomaly": { "lower": 15, "upper": 85 },
      "critical": { "lower": 5, "upper": 95 }
    },
    "momentum": {
      "anomaly_trigger": "volatility_increase > 2x in 3 days",
      "critical_trigger": "price_drop > 5% in 2 days"
    }
  },
  "action_on_anomaly": "redirect_to_MAGE-IN",
  "action_on_critical": "halt_and_alert_MOD",
  "learning_mode": true
}
